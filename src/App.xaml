<Application x:Class="BlueBridge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
        <SolidColorBrush x:Key="WindowBackground" Color="#101018" />
        <SolidColorBrush x:Key="CardBackground" Color="#191923" />
        <SolidColorBrush x:Key="CardBorder" Color="#2B2A38" />
        <SolidColorBrush x:Key="Primary" Color="#8067F4" />
        <SolidColorBrush x:Key="PrimaryHover" Color="#927CF8" />
        <SolidColorBrush x:Key="PrimaryPressed" Color="#6D51E8" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F1FF" />
        <SolidColorBrush x:Key="TextMuted" Color="#AAA7B7" />
    </Application.Resources>
</Application>
